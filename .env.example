# Neo Environment Configuration
# Copy this file to .env and populate your secrets

# OpenAI-Compatible AI API (e.g. https://api.hcnsec.cn/v1 or custom proxy)
OPENAI_BASE_URL=https://api.hcnsec.cn/v1
OPENAI_API_KEY=your_openai_or_hcnsec_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# IMAP & SMTP Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
ADMIN_EMAIL=admin@example.com

# Telegram Bot Configuration
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
